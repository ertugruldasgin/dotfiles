export EDITOR=nvim
export VISUAL="$EDITOR"
export PAGER=less
export LANG=en_US.UTF-8
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
mkdir -p "$XDG_STATE_HOME"
export LESS='-R -F -i -M -S'
export LESSHISTFILE="$XDG_STATE_HOME/less_history"
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export AWS_PAGER=""

{{ if eq .chezmoi.os "darwin" -}}
for gnubin in coreutils gnu-sed findutils; do
    d="$(brew --prefix 2>/dev/null)/opt/$gnubin/libexec/gnubin"
    [ -d "$d" ] && PATH="$d:$PATH"
done
unset gnubin d
{{ end -}}

for dir in "$HOME/.local/bin" "$GOBIN" "$HOME/.cargo/bin" "$HOME/.npm-global/bin" /usr/local/go/bin; do
    case ":$PATH:" in
        *":$dir:"*) ;;
        *) PATH="$dir:$PATH" ;;
    esac
done
unset dir
export PATH

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --preview "bat -n --color=always --line-range :300 {} 2>/dev/null || eza -1 --color=always {}" --preview-window right:55% --bind ctrl-/:toggle-preview'
export FZF_CTRL_T_OPTS='--preview "bat -n --color=always {} 2>/dev/null"'

{{ if eq (get .chezmoi.osRelease "id") "ubuntu" -}}
command -v vivid >/dev/null && export LS_COLORS="$(vivid generate nord)"
{{ end -}}
