#!/usr/bin/env bash
set -euo pipefail

{{ if not (or (eq .chezmoi.hostname "sar6on") (eq .chezmoi.os "darwin")) }}
FONT_DIR="$HOME/.local/share/fonts/JetBrainsMono"
if [ ! -d "$FONT_DIR" ] && command -v unzip >/dev/null; then
    mkdir -p "$FONT_DIR"
    curl -fLo /tmp/jbm.zip \
      https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip
    unzip -oq /tmp/jbm.zip -d "$FONT_DIR"
    rm -f /tmp/jbm.zip
    fc-cache -f "$FONT_DIR"
fi
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
if ! command -v starship >/dev/null; then
    mkdir -p "$HOME/.local/bin"
    curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"
fi
{{ end }}

{{ if ne .chezmoi.hostname "sar6on" }}
command -v c_formatter_42 >/dev/null || pip install --user --quiet c-formatter-42
{{ end }}
