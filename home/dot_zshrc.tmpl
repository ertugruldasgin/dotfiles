{{ if eq .chezmoi.os "darwin" -}}
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

[ -f ~/.config/shell/env ]     && . ~/.config/shell/env
[ -f ~/.config/shell/aliases ] && . ~/.config/shell/aliases

HISTFILE=~/.local/share/zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY

setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt LONG_LIST_JOBS
setopt NOTIFY

setopt ALWAYS_TO_END
setopt AUTO_MENU
setopt COMPLETE_IN_WORD
setopt AUTO_PARAM_SLASH
setopt PATH_DIRS

ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$ZSH_CACHE_DIR"

autoload -Uz compinit && compinit -d "$ZSH_CACHE_DIR/zcompdump"

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{green}-- %d --%f'
zstyle ':completion:*:warnings'     format '%F{red}no matches: %d%f'
zstyle ':completion:*:*:*:*:processes' command 'ps -u $USER -o pid,cmd -w'
zstyle ':completion:complete:*:options' sort false
zstyle ':completion::complete:*' use-cache on
zstyle ':completion::complete:*' cache-path "$ZSH_CACHE_DIR"
[ -n "$LS_COLORS" ] && zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

bindkey -e

autoload -Uz select-word-style && select-word-style bash

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

fancy-ctrl-z() {
  if [[ $#BUFFER -eq 0 ]]; then
    BUFFER="fg"
    zle accept-line -w
  else
    zle push-input -w
    zle clear-screen -w
  fi
}
zle -N fancy-ctrl-z
bindkey '^Z' fancy-ctrl-z

rationalise-dot() {
  if [[ $LBUFFER =~ '(^| |\.\./)\.\.$' ]]; then
    LBUFFER+=/..
  else
    LBUFFER+=.
  fi
}
zle -N rationalise-dot
bindkey . rationalise-dot

unalias run-help 2>/dev/null
autoload -Uz run-help
bindkey '\eh' run-help

autoload -Uz zmv
alias mmv='noglob zmv -W'

autoload -Uz url-quote-magic bracketed-paste-magic
zle -N self-insert url-quote-magic
zle -N bracketed-paste bracketed-paste-magic

zmodload zsh/datetime
autoload -Uz add-zsh-hook

NOTIFY_MIN=30
NOTIFY_IGNORE=(nvim vim ssh tmux lazygit less man htop top fg)

_notify() {
  local seq=$'\e]777;notify;'"$1;$2"$'\a'
  if [[ -n $TMUX ]]; then
    printf '\ePtmux;\e%s\e\\' "$seq"
  else
    printf '%s' "$seq"
  fi
}
_cmd_start() {
  _cmd_ts=$EPOCHSECONDS
  _cmd_name=${1%% *}
  _cmd_line=${1//;/,}
}
_cmd_notify() {
  local st=$?
  (( _cmd_ts )) || return
  local d=$(( EPOCHSECONDS - _cmd_ts )); _cmd_ts=0
  (( d >= NOTIFY_MIN )) || return
  (( ${NOTIFY_IGNORE[(Ie)$_cmd_name]} )) && return

  local t title
  (( d >= 60 )) && t="$((d / 60))m $((d % 60))s" || t="${d}s"
  if (( st == 0 )); then
    title="✓ ${_cmd_line[1,50]}"
  else
    title="✗ ${_cmd_line[1,50]} (exit $st)"
  fi
  _notify "$title" "$t - ${PWD:t}"
}
add-zsh-hook preexec _cmd_start
add-zsh-hook precmd  _cmd_notify

command -v eza >/dev/null && {
  alias ls='eza --group-directories-first'
  alias ll='eza -lh --git --group-directories-first'
  alias la='eza -lah --git --group-directories-first'
  alias lt='eza --tree --level=2'
}
command -v bat >/dev/null && {
  alias cat='bat -pp'
  export BAT_PAGER='less -RF'
}

command -v fdfind >/dev/null && ! command -v fd >/dev/null && alias fd='fdfind'

command -v fzf >/dev/null && source <(fzf --zsh)

[ -f ~/.local/share/zsh/fzf-tab/fzf-tab.plugin.zsh ] && {
  source ~/.local/share/zsh/fzf-tab/fzf-tab.plugin.zsh
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
  zstyle ':fzf-tab:complete:*:*'  fzf-preview 'bat -n --color=always $realpath 2>/dev/null || eza -1 --color=always $realpath'
  zstyle ':fzf-tab:*' switch-group ',' '.'
}

command -v zoxide   >/dev/null && eval "$(zoxide init zsh --cmd cd)"
command -v starship >/dev/null && eval "$(starship init zsh)"

{{ if eq .chezmoi.os "darwin" -}}
ZSH_PLUGIN_DIR="$(brew --prefix 2>/dev/null)/share"
{{ else -}}
ZSH_PLUGIN_DIR=/usr/share
{{ end -}}
for d in "$ZSH_PLUGIN_DIR" "$HOME/.local/share/zsh"; do
  [ -f "$d/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    . "$d/zsh-autosuggestions/zsh-autosuggestions.zsh" && break
done
for d in "$ZSH_PLUGIN_DIR" "$HOME/.local/share/zsh"; do
  [ -f "$d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    . "$d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" && break
done
unset ZSH_PLUGIN_DIR d
